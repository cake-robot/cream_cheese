<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.creamcheese.live</string>

    <!-- Runs unbounded -- no --live-until, no StartCalendarInterval window.
         Cadence is derived at runtime from the kickoff times already in
         `games` (src/live.py's _schedule_interval): ~10min while a game is
         live or within ~15min of kickoff, sleeping up to 30min otherwise.
         The process also manages its own `caffeinate -i` child, asserted
         only from ~3h before the day's first kickoff through the last game
         -- NOT wrapped around the whole process the way it used to be,
         since an always-on process with an unconditional caffeinate would
         never let the Mac idle-sleep at all. See _sync_caffeinate.

         FALLBACK: if the schedule-aware cadence ever needs to be bypassed
         (e.g. the DB's kickoff schedule is stale/wrong on a gameday),
         add "--live-interval" / "60" as two more strings in the array
         below (or run `just live-fixed`). That forces the old fixed-60s,
         always-awake behaviour with no code change. A full revert of this
         file is also one command: `git checkout 2fa1af9 -- deploy/com.creamcheese.live.plist`. -->
    <key>ProgramArguments</key>
    <array>
        <string>/Users/ericsayre/Documents/cream_cheese/venv/bin/python</string>
        <string>pipeline.py</string>
        <string>--live</string>
    </array>

    <!-- config.DB_PATH is a relative path ("data/cfb.db") and pipeline.py
         resolves it against cwd, not against the script's own location --
         this MUST be set correctly or the live poller will create/open the
         wrong database file. src/live.py's LOCK_PATH ("data/live.lock") is
         the same kind of cwd-relative path. -->
    <key>WorkingDirectory</key>
    <string>/Users/ericsayre/Documents/cream_cheese</string>

    <!-- Always on: starts at login (RunAtLoad) and is kept running
         (KeepAlive) rather than started on a Thu/Fri/Sat calendar window --
         that window was only ever a proxy for "when are games on", and
         missed Tue/Wed MACtion and weekday bowl/CFP games entirely. Note
         the old StartCalendarInterval's "Hour: 9" was LOCAL time despite
         being documented elsewhere as "09:00 ET" -- a latent inconsistency
         that goes away here since all of _schedule_interval's math is
         UTC-vs-UTC. `just discover` still matters: an undiscovered game
         (e.g. season_type=3/postseason, never pulled for a season) is only
         found on the next scoreboard pull, up to 30min after the poller
         goes idle-active for it -- see _schedule_interval's docstring. -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <!-- Must live outside ~/Documents -- see com.creamcheese.serve.plist for
         why (xpcproxy's stdio-redirect open gets a TCC EPERM otherwise). -->
    <key>StandardOutPath</key>
    <string>/Users/ericsayre/Library/Logs/creamcheese/live.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/ericsayre/Library/Logs/creamcheese/live.log</string>
</dict>
</plist>
